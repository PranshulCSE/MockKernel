# Google OAuth client ID from Google Cloud Console (Web application).
# The client uses Google Identity Services <GoogleLogin> and sends the resulting
# ID token (credential) to POST /api/auth/google as { idToken }.
# Leave empty to use the mock Google sign-in during development.
VITE_GOOGLE_CLIENT_ID=

# Backend origin. Set this to the public Server URL on Railway before building Client.
VITE_API_URL=http://localhost:3000
