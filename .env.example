# Server Configuration
NODE_ENV=development
PORT=3000

# CORS Allowlist (comma-separated origins)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# MongoDB Connection (required)
MONGODB_URI=mongodb://127.0.0.1:27017/mockkernel

# Redis Configuration (BullMQ, Rate Limiter, Leaderboard)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional full Redis URL (overrides host/port/password if set)
# REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_FAIL_OPEN=true

# Authentication (JWT_SECRET required, min 8 chars in dev, 16+ in production)
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Google OAuth (optional; required for POST /api/auth/google)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Groq AI Interview Service (optional; required for /api/interviews)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Judge0 Code Execution Engine
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=

# Queue & Plagiarism Settings
SUBMISSION_QUEUE_NAME=submission-queue
PLAGIARISM_THRESHOLD=0.85
