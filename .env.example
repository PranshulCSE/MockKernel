# Server Configuration
NODE_ENV=development
PORT=3000

# CORS Allowlist (comma-separated origins)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# MongoDB Connection (required)
MONGODB_URI=mongodb://127.0.0.1:27017/mockkernel

# Redis Configuration (BullMQ, Rate Limiter, Leaderboard)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional full Redis URL (overrides host/port/password if set)
# REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_FAIL_OPEN=true

# Authentication (JWT_SECRET required, min 8 chars in dev, 16+ in production)
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# SMTP for six-digit email verification codes (optional until verification is used)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth (optional; required for POST /api/auth/google)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
# Server-side only; not needed for the ID-token flow.
GOOGLE_CLIENT_SECRET=

# Groq AI Interview Service (optional; required for /api/interviews)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Judge0 Code Execution Engine
JUDGE0_API_URL=http://localhost:2358
# Server/Worker also accept JUDGE0_AUTH_TOKEN as an alias for this value.
JUDGE0_API_KEY=
# JUDGE0_AUTH_TOKEN=

# Seed Accounts (run from Server/: npx tsx src/scripts/seed.ts)
SEED_SUPERADMIN_NAME=MockKernel Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@gmail.com
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_EMAIL=admin@gmail.com
# SEED_SUPERADMIN_PASSWORD=replace_with_a_long_password
# SEED_DEMO_PASSWORD=MockKernel@123

# Queue & Plagiarism Settings
SUBMISSION_QUEUE_NAME=submission-queue
PLAGIARISM_THRESHOLD=0.85
