{
  "name": "worker",
  "version": "1.0.0",
  "description": "Background execution worker for MockKernel",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\" && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.0",
    "bullmq": "^6.6.0",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^3.1.1"
  }
}
